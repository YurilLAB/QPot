# Tool versions and settings shared by .github/workflows/ci.yml and
# scripts/ci-local.sh, so a local run checks exactly what CI checks. This
# is the only place they are set: every CI job that needs them appends this
# file to $GITHUB_ENV, and ci-local reads it; a test in internal/cicheck
# fails if either keeps a copy of its own.
# Format: KEY=value, values only letters, digits and . , _ + -
GOVULNCHECK_VERSION=v1.1.4
GOSEC_VERSION=v2.22.7
STATICCHECK_VERSION=2025.1.1
ACTIONLINT_VERSION=v1.7.7
GITLEAKS_VERSION=8.24.3
SHELLCHECK_VERSION=v0.10.0
SHELLCHECK_SHA256=6c881ab0698e4e6ea235245f22832860544f17ba386442fe7e9d629f8cbedf87
# gosec rules left out, and why: G204 (docker is exec'd by design, with
# validated arguments), G301/G302/G306 (honeypot folders and decoy configs
# must be readable by the containers' non-root user; the secret qpot.id is
# 0600), G101 (the fake /etc/passwd the honeypots serve), G115 (intended FNV
# hash truncation), G104 (unhandled-error noise), G304 (internal, not
# web-controlled paths). G117 (secrets in marshalled structs: attackers'
# passwords are stored on purpose) and G118 (context propagation) only exist
# in newer gosec releases. Every other rule, weak crypto included, is on.
GOSEC_EXCLUDES=G104,G115,G204,G304,G301,G302,G306,G101,G117,G118
