# QPot high-interaction SSH backend sshd_config.
#
# This is a REAL OpenSSH server (that is the whole point — no emulated transport
# to fingerprint). It is configured to (a) accept the weak credentials attackers
# try, so they get a genuine shell we can record, and (b) refuse to be turned
# into a network pivot, as defense-in-depth on top of the egress-locked network.

Port 22
AddressFamily any
ListenAddress 0.0.0.0

# Host keys live below /run/sshd/bootstrap, a private parent of the read-only
# SHARED volume mounted identically into every
# backend in the pool, so all backends present the SAME host-key fingerprint. A
# pool of backends behind one broker that each had their own keys would make a
# returning attacker's SSH client warn "REMOTE HOST IDENTIFICATION HAS CHANGED" —
# an instant honeypot/pool tell. Keeping the keys out of /etc/ssh also means the
# shared mount never shadows this hardened sshd_config. sshd reads the copies the
# entrypoint makes, root's alone: it refuses a host key others may read, and a
# mounted file keeps the host's mode (Docker Desktop shows Windows files as 0777).
# The private bootstrap parent also prevents reading those original files.
HostKey /run/sshd/hostkeys/ssh_host_ed25519_key
HostKey /run/sshd/hostkeys/ssh_host_rsa_key
HostKey /run/sshd/hostkeys/ssh_host_ecdsa_key

# VERBOSE retains authentication metadata and offered key fingerprints in the
# private daemon log. Command/PTY evidence is separately encoded as JSONL.
LogLevel VERBOSE
SyslogFacility AUTH

# We WANT logins: the value of a high-interaction honeypot is the post-login
# behaviour. Password auth and root login are intentionally enabled.
PermitRootLogin yes
PasswordAuthentication yes
PubkeyAuthentication yes
PermitEmptyPasswords no
KbdInteractiveAuthentication no
UsePAM yes

# A real server's grace/auth limits, so the pre-auth behaviour matches OpenSSH.
LoginGraceTime 120
MaxAuthTries 6
MaxSessions 10

# Defense-in-depth: even though the backend sits on an egress-locked internal
# network, explicitly refuse every forwarding/tunnelling primitive so a real
# shell cannot use SSH forwarding primitives. The private cell may deliberately
# allow ordinary SSH/SQL clients to reach its own decoy peers; the network guard
# must enforce isolation from every other cell, the host and real infrastructure.
AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
GatewayPorts no
PermitTunnel no
X11Forwarding no
PermitUserRC no

PrintMotd no
PrintLastLog yes
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server
# The account's login shell is rec-shell. Running the recorder directly avoids
# user-writable Bash startup files before admission and preserves key commands.
